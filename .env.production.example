# =====================================================================
# PRODUCCIÓN (EC2 -> Supabase). Copia a .env.production y rellena.
# NO se versiona (.env.production va en .gitignore). chmod 600 en la EC2.
# =====================================================================
ENVIRONMENT=production

# --- Base de datos: Supabase (NO se corre Postgres local en prod) ---
# DATABASE_URL tiene prioridad. Usa el SESSION pooler (puerto 5432) — soporta
# todo y va bien para una app persistente en una sola EC2.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-1-us-east-1.pooler.supabase.com:5432/postgres
POSTGRES_SSLMODE=require

# --- Autenticación (OBLIGATORIO en prod) ---
# Supabase -> Project Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET=<JWT_SECRET_DE_SUPABASE>
SUPABASE_JWT_AUDIENCE=authenticated

# --- Acceso a la sala del paciente anónimo (OBLIGATORIO en prod) ---
# Firma los tokens con los que el paciente sin cuenta abre SU videoconsulta. La app NO ARRANCA
# en producción si se queda con el valor por defecto.
# Genéralo con 32 bytes aleatorios y NO reutilices el JWT secret de Supabase: si ambos usaran el
# mismo, un token de sala y uno de sesión serían indistinguibles.
#   openssl rand -base64 32
# Rotarlo invalida al instante los tokens vigentes: un paciente que esté esperando pierde el
# acceso a su sala. Hazlo en horario de baja demanda.
CONSULTATION_TOKEN_SECRET=<GENERA_UNO_PROPIO_NO_LO_COPIES_DE_AQUI>

# --- Clave de cifrado de datos clínicos (AES-256-GCM) ---
# OBLIGATORIA: la app no arranca con el valor por defecto. Cifra motivos, notas, antecedentes y
# alergias en la base; vive SOLO aquí (nunca en Supabase ni en el frontend). Genérala con:
#   python scripts/encrypt_clinical_data.py --generate-key
# ⚠️ Perderla = perder todo el contenido clínico. Custodia: gestor de contraseñas de la
# organización + copia sellada, igual que la passphrase clínica. Ver docs/cifrado-datos-clinicos.md.
CLINICAL_DATA_ENCRYPTION_KEY=<GENERA_UNA_PROPIA_NO_LA_COPIES_DE_AQUI>
# Solo durante una rotación: la(s) clave(s) anterior(es), coma-separadas, para descifrar lo
# viejo hasta que el script lo re-cifre. Vacía el resto del tiempo.
CLINICAL_DATA_ENCRYPTION_PREVIOUS_KEYS=

# --- CORS: dominio(s) del frontend (separa con comas). NO uses "*" en prod. ---
# La app tampoco arranca si esto queda en "*": el middleware envía credenciales.
BACKEND_CORS_ORIGINS=https://tu-frontend.com

# --- Dirección cifrada E2E (bloque de seguridad) ---
# Emails (coma-separados) que pueden ver la dirección cifrada (ciphertext) de CUALQUIER paciente,
# además del médico tratante. La dirección se cifra en el navegador del paciente con la clave
# pública clínica (X25519 sealed box); la API NUNCA la descifra ni la loguea. Esta variable solo
# decide a QUIÉN se le sirve la ciphertext en GET /patients/{id}/address.
# Default: la responsable de protección de datos. CAMBIA esto en producción si es necesario.
ADDRESS_VIEWER_EMAILS=orianaramirez@gmail.com

# --- Adjuntos clínicos del chat: Supabase Storage (OBLIGATORIO para la mensajería) ---
# Los PDFs y las imágenes clínicas del buzón médico ↔ paciente viven en un bucket PRIVADO de
# Supabase Storage, no en el disco del contenedor (ahí se pierden al redeploy y no se ven entre
# réplicas). Se accede con el service-role key: el anon key no puede leer un bucket privado.
# La app NO ARRANCA en producción si SUPABASE_SERVICE_ROLE_KEY se queda con el valor por
# defecto, y el arranque avisa en los logs del bucket y la URL que va a usar.
#
# ⚠️ Provisión manual, una vez por proyecto: Supabase -> Storage -> New bucket, nombre
# `chat-attachments`, "Public bucket" DESMARCADO. No hace falta ninguna policy de RLS: el
# service-role key las salta y el navegador nunca habla con Storage (la descarga pasa por
# GET /api/v1/consultations/{id}/attachments/{id}, que exige pertenencia y audita la lectura).
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY_DE_SUPABASE>
# Solo si Storage vive detrás de otro host/gateway. Vacía = {SUPABASE_URL}/storage/v1.
# SUPABASE_STORAGE_URL=
# STORAGE_BUCKET_ATTACHMENTS=chat-attachments

# --- Mensajería médico ↔ paciente (buzón web, Fase 1) ---
# Opcionales: los valores comentados son los de por defecto. Ver .env.example para el detalle
# de cada una; aquí solo se listan para poder ajustarlas sin tocar el código.
# MESSAGING_AFTER_CLOSE_HOURS=72
# MESSAGING_MAIL_DEBOUNCE_MINUTES=15
# MESSAGING_PATIENT_HOURLY_LIMIT=30
# MESSAGING_MAX_BODY_CHARS=2000
# MESSAGING_PATIENT_PRESENCE_TTL_SECONDS=45
# MESSAGING_MAX_ATTACHMENT_SIZE_BYTES=10485760
# MESSAGING_ALLOWED_ATTACHMENT_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp
# ⚠️ La presencia del paciente ("En línea" en el buzón) se guarda en memoria del proceso: solo
# es fiable con UNA réplica de uvicorn. Con varias, cada una ve su propia mitad.

# --- Opcionales ---
JITSI_DOMAIN=meet.jit.si
STALE_CONSULTATION_MINUTES=30
RATE_LIMIT_ENABLED=true
DOCTOR_REGISTER_RATE_LIMIT=5/minute
PUBLIC_WRITE_RATE_LIMIT=10/minute
# Respuestas a las encuestas de marketing: llegan en ráfaga tras cada correo masivo, así que va más
# holgado que el alta pública. Subirlo si durante una campaña aparecen 429 en los logs.
SURVEY_RESPONSE_RATE_LIMIT=60/minute
# Clave de la API v4 de Kit (Settings -> Developer): el panel lee de Kit enviados, aperturas, clics
# y bajas de cada envio de las encuestas. Sin ella, Marketing -> Graficos muestra solo las
# respuestas y avisa que falta. Da acceso a la cuenta de Kit (incluidos los suscriptores).
KIT_API_KEY=
# Vida del token de sala. 24 h cubre la espera real; acortarlo arriesga dejar fuera de su propia
# sala a un paciente anónimo, que no tiene forma de re-emitirlo.
CONSULTATION_TOKEN_TTL_HOURS=24
# Ventana de cutover SOLO: ponlo en false para desplegar el backend antes que el frontend que ya
# manda el token, y devuélvelo a true en cuanto el frontend esté arriba. En false, cualquiera con
# el id de la consulta abre la sala — que es el agujero que este token cierra.
CONSULTATION_TOKEN_REQUIRED=true
# Emisor esperado del JWT de Supabase ({SUPABASE_URL}/auth/v1). Sin definir, no se verifica `iss`.
SUPABASE_JWT_ISSUER=
